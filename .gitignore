# --- Secrets (never commit) ---
.env
.env.*
!.env.example
*.key
*.pem

# --- Local database / app data ---
*.db
*.db-journal
*.sqlite
*.sqlite3
.spiced/
data/*.db

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
.eggs/
build/
dist/
sdist/
wheels/
develop-eggs/
.installed.cfg

# --- Virtual environments ---
.venv/
venv/
env/
ENV/
.python-version

# --- Testing / coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.cache/

# --- Tooling / caches ---
.ruff_cache/
.mypy_cache/

# --- Editors / OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Windows installer build (Finding 3 fixes 2/4) ---
# A vendored ffmpeg.exe is a build-time input a maintainer places by hand
# (see packaging/vendor/README.md) -- a compiled binary has no business in
# version control, and its redistribution terms are a build-time decision.
packaging/vendor/ffmpeg/*.exe
# Inno Setup's compiled output (Spiced-Setup.exe).
packaging/output/
