# Spiced backend local configuration example.
# Copy this file to ".env" (gitignored) and fill in your own values. Never
# commit a real .env file or paste real keys into code, logs, or screenshots.

# Supabase project URL, e.g. https://<ref>.supabase.co
SUPABASE_URL=

# Supabase anon (public) key. Safe to expose to clients, used here only to
# call Supabase Auth's GET /auth/v1/user endpoint for token verification.
SUPABASE_ANON_KEY=

# Supabase service role key. Never expose this to the desktop client — kept
# server-side only. Not currently required by any endpoint but reserved for
# future admin-level Supabase Auth calls.
SUPABASE_SERVICE_ROLE_KEY=

# SQLAlchemy database URL for the hosted Postgres instance, e.g.
# postgresql+psycopg://postgres:<password>@<host>:5432/postgres
# (Supabase gives you a plain postgresql:// URL — swap the scheme to
# postgresql+psycopg:// so SQLAlchemy uses the psycopg driver.)
DATABASE_URL=
