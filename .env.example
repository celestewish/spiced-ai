# Spiced local configuration example.
# Copy this file to ".env" and fill in your own values.
# NEVER commit your real .env file or paste real keys into code, logs, or screenshots.

# --- OpenAI (default provider) ---
# OpenAI API key. Get one at https://platform.openai.com/api-keys
# The app reads this from the environment (or a local .env) at runtime.
OPENAI_API_KEY=your-openai-api-key-here

# Optional: override the OpenAI model. Defaults to a conservative, widely
# available model. If you see a "model not found" error, set this to a model
# your API key has access to.
# OPENAI_MODEL=gpt-4o-mini

# --- Provider selection ---
# Optional: choose the active AI provider ("openai", "mock", or "gemini").
# Defaults to "openai". Use "mock" for free, offline testing.
# SPICED_AI_PROVIDER=openai

# --- Gemini (optional, not the default) ---
# Only needed if you switch the provider to "gemini". Requires the optional
# "gemini" extra: pip install -e ".[gemini]"
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-2.0-flash

# --- Discord (optional, for Community Pulse Check-ins) ---
# Community Pulse is off by default and uses the free "mock" source unless you
# opt in from the Feedback Review screen AND set both of these. The bot only
# ever reads message history from the one channel below — read-only, no
# posting, no DMs.
# DISCORD_BOT_TOKEN=your-discord-bot-token-here
# DISCORD_CHANNEL_ID=your-discord-channel-id-here

# --- Small-Team Mode (optional) ---
# Off by default — Solo-Dev Mode never reads these. Only needed if you sign in
# from the Projects screen's "Team" section to link a project to a team.
# SUPABASE_URL is your Supabase project's URL; SUPABASE_ANON_KEY is its public
# (client-safe) anon key — never put the service role key here, that belongs
# only in backend/.env. SPICED_BACKEND_URL points at a running instance of
# this repo's backend/ service (see backend/README.md); it defaults to
# http://127.0.0.1:8000 for local development.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-key-here
# SPICED_BACKEND_URL=http://127.0.0.1:8000
